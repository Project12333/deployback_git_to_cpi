operty Name="statusComments" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="false" sap:filterable="true" sap:field-control="jobAppPermissionsNav/statusComments" sap:label="Status Comments"></Property><Property Name="timeToHire" Type="Edm.Double" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="true" sap:label="Time to Hire"></Property><Property Name="usersSysId" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="true" sap:label="User id"></Property><Property Name="zip" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:field-control="jobAppPermissionsNav/zip" sap:label="Zip"></Property><NavigationProperty Name="Cust_MaritalStatus" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:picklist="ecMaritalStatus" Relationship="SFOData.JobAppCustomField_assos_prefix_Cust_MaritalStatus_picklist" FromRole="JobApplication" ToRole="PicklistOption" sap:field-control="jobAppPermissionsNav/Cust_MaritalStatus" sap:label="MaritalStatus"></NavigationProperty><NavigationProperty Name="Cust_Salutation" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:picklist="salutation" Relationship="SFOData.JobAppCustomField_assos_prefix_Cust_Salutation_picklist" FromRole="JobApplication" ToRole="PicklistOption" sap:field-control="jobAppPermissionsNav/Cust_Salutation" sap:label="Salutation"></NavigationProperty><NavigationProperty Na