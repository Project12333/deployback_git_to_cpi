abel="CandidateBackground_OutsideWorkExperience" sap:creatable="true" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>Candidate Background</Summary><LongDescription>These entities represent the background elements as defined in the candidate template. For example:CandidateBackground_Certificate, CandidateBackground_Education, etc</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Candidate</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="JobApplicationOnboardingData" EntityType="SFOData.JobApplicationOnboardingData" sap:label="JobApplicationOnboardingData" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>JobApplicationOnboardingData</Summary><LongDescription>The JobApplicationOnboardingData represents the Onboarding portlet of a job application.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Application</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FormSignatureSection" EntityType="SFOData.FormSignatureSection" sap:label="FormSignatureSection" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>FormSignatureSection</Summary><LongDescription>Contains basic information of signature section associated with the form.</LongDescription><sap:tagcollection><sap:tag>Performance and Goals (PM/GM)</sap:tag><sap:tag>PM/GM - Continuous Performance Management</sap:tag><sap:tag>PM - Forms Management</sap:tag><sap:tag>Results List Not Supported</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FOJobClassLocalITA" EntityType="SFOData.FOJobClassLocalITA" sap:label="Job Classification Italy " sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>FOJobClassLocalITA</Summary><LongDescription>This is a foundation object that contains country-specific job class for ITA.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="PayPeriod" EntityType="SFOData.PayPeriod" sap:label="Pay Period" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>PayPeriod</Summary><LongDescription>This is a foundation object that describes one particular pay period. This is a time interval for which employees are paid.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FOPayRange" EntityType="SFOData.FOPayRange" sap:label="Pay Range" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>FOPayRange</Summary><LongDescription>This is a foundation object that contains pay range related information.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="JobProfile" EntityType="SFOData.JobProfile" sap:label="Job Profile" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>JobProfile</Summary><LongDescription>Contains detailed profiling information of a job. It inherits all of the competency and skill information from a job role and describes additional job information, such as education, certification, and physical requirements.</LongDescription><sap:tagcollection><sap:tag>Suite (STE)</sap:tag><sap:tag>STE - Skills Management</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="cust_Profit_Center" EntityType="SFOData.cust_Profit_Center" sap:label="Profit Center" sap:creatable="true" sap:updatable="true" sap:upsertable="tr